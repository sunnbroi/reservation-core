#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__).'/vendor/autoload.php';

use Reservation\Support\Runtime;
use Reservation\Http\Api;

try {
    $runtime = new Runtime(timeoutAfterCharge: getenv('DEMO_TIMEOUT_AFTER_CHARGE') === '1');
    $command = $argv[1] ?? 'help';
    switch ($command) {
        case 'migrate':
            $runtime->transaction->run(function () use ($runtime): void {
                $runtime->pdo->exec('SELECT pg_advisory_xact_lock(762019635)');
                $runtime->pdo->exec('CREATE TABLE IF NOT EXISTS schema_migrations (version varchar(80) PRIMARY KEY)');
                foreach (glob(dirname(__DIR__).'/database/*.sql') ?: [] as $file) {
                    $version = basename($file);
                    $check = $runtime->pdo->prepare('SELECT 1 FROM schema_migrations WHERE version = :version');
                    $check->execute(['version' => $version]);
                    if ($check->fetchColumn() !== false) {
                        continue;
                    }
                    $runtime->pdo->exec(file_get_contents($file));
                    $runtime->pdo->prepare('INSERT INTO schema_migrations VALUES (:version)')->execute(['version' => $version]);
                }
            });
            echo "Migrations applied.\n";
            break;
        case 'seed':
            $runtime->pdo->exec("INSERT INTO slots (id, title, capacity, price_minor, currency, starts_at) VALUES ('11111111-1111-4111-8111-111111111111', 'Synthetic workshop', 1, 250000, 'RUB', clock_timestamp() + interval '7 days') ON CONFLICT (id) DO NOTHING");
            echo "Demo slot: 11111111-1111-4111-8111-111111111111 (one place, 250000 minor units RUB).\n";
            break;
        case 'worker':
            if (in_array('--once', $argv, true)) {
                $runtime->worker->runOne();
                break;
            }
            if (in_array('--drain', $argv, true)) {
                while ($runtime->worker->runOne()) {}
                break;
            }
            while (true) {
                if (!$runtime->worker->runOne()) {
                    usleep(250000);
                }
            }
        case 'reconcile':
            $booking = $runtime->payments->reconcile($argv[2] ?? '');
            echo json_encode(Api::present($booking), JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
            break;
        case 'expire':
            $slots = $runtime->pdo->query("SELECT DISTINCT slot_id FROM bookings WHERE status = 'held' AND expires_at <= clock_timestamp()")->fetchAll(PDO::FETCH_COLUMN);
            $count = 0;
            foreach ($slots as $slot) {
                $count += $runtime->bookings->expireSlot($slot);
            }
            echo json_encode(['expired' => $count], JSON_THROW_ON_ERROR)."\n";
            break;
        case 'status':
            echo json_encode([
                'bookings' => $runtime->pdo->query('SELECT status, count(*) FROM bookings GROUP BY status ORDER BY status')->fetchAll(),
                'outbox' => $runtime->pdo->query('SELECT status, count(*) FROM outbox GROUP BY status ORDER BY status')->fetchAll(),
                'provider_payments' => (int) $runtime->pdo->query('SELECT count(*) FROM demo_provider_payments')->fetchColumn(),
                'notifications' => (int) $runtime->pdo->query('SELECT count(*) FROM demo_notifications')->fetchColumn(),
            ], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
            break;
        default:
            echo "Commands: migrate, seed, worker [--once|--drain], reconcile <booking-id>, expire, status\n";
            if ($command !== 'help') {
                exit(1);
            }
    }
} catch (Throwable $error) {
    fwrite(STDERR, json_encode(['error' => $error::class, 'message' => $error->getMessage()], JSON_THROW_ON_ERROR)."\n");
    exit(1);
}
