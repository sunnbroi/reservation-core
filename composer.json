{
  "name": "sunnbroi/reservation-core",
  "description": "Standalone reservation and payment coordination module with PostgreSQL concurrency control and transactional outbox.",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.4", "ext-json": "*", "ext-pdo": "*", "ext-pdo_pgsql": "*"},
  "require-dev": {
    "laravel/pint": "^1.24",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {"psr-4": {"Reservation\\": "src/"}},
  "autoload-dev": {"psr-4": {"Reservation\\Tests\\": "tests/"}},
  "scripts": {
    "format": "pint",
    "format:check": "pint --test",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "analyse": "phpstan analyse --memory-limit=256M",
    "check": ["@composer validate --strict", "@format:check", "@analyse", "@test"]
  },
  "config": {"sort-packages": true, "allow-plugins": false}
}
